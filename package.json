{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:legacy": "node tests/starter.spec.mjs && node tests/service-worker.spec.ts && node tests/offline.spec.ts && node tests/rendering.spec.ts && tsx tests/sync.spec.ts && tsx tests/capabilities.spec.ts",
    "test:unit": "tsx --test tests/unit/*.spec.ts",
    "test:integration": "tsx --test tests/integration/*.spec.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:legacy && npm run test:unit && npm run test:integration",
    "verify": "node scripts/verify.mjs",
    "lint": "next lint",
    "test:coverage": "tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/unit/*.spec.ts tests/integration/*.spec.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
